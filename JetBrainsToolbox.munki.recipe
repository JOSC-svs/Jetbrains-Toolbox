<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Imports the Apple Silicon build of JetBrains Toolbox into Munki. Edit Input and pkginfo to match your environment.</string>
    <key>Identifier</key>
    <string>local.munki.JetBrainsToolbox</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>JetBrainsToolbox</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/JetBrainsToolbox</string>
        <key>MUNKI_CATALOG</key>
        <string>testing</string>
        <key>MUNKI_CATEGORY</key>
        <string>Developer Tools</string>
        <key>MUNKI_DEVELOPER</key>
        <string>JetBrains</string>
        <key>MUNKI_DESCRIPTION</key>
        <string>Manages installations and updates of JetBrains IDEs.</string>
        <key>MUNKI_DISPLAY_NAME</key>
        <string>JetBrains Toolbox</string>
    </dict>
    <key>MinimumVersion</key>
    <string>2.4.1</string>
    <key>ParentRecipe</key>
    <string>local.download.JetBrainsToolbox</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
                <key>pkginfo</key>
                <dict>
                    <key>blocking_applications</key>
                    <array>
                        <string>JetBrains Toolbox</string>
                    </array>
                    <key>catalogs</key>
                    <array>
                        <string>%MUNKI_CATALOG%</string>
                    </array>
                    <key>category</key>
                    <string>%MUNKI_CATEGORY%</string>
                    <key>developer</key>
                    <string>%MUNKI_DEVELOPER%</string>
                    <key>description</key>
                    <string>%MUNKI_DESCRIPTION%</string>
                    <key>display_name</key>
                    <string>%MUNKI_DISPLAY_NAME%</string>
                    <key>name</key>
                    <string>%NAME%</string>
                    <key>supported_architectures</key>
                    <array>
                        <string>arm64</string>
                    </array>
                    <key>unattended_install</key>
                    <true/>
                </dict>
            </dict>
        </dict>
    </array>
</dict>
</plist>

